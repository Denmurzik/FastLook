<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{5B1C2E7A-3F4D-4A8B-9C61-7D2E0F13A4B5}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>FastLook</RootNamespace>
    <ProjectName>FastLook.Viewer</ProjectName>
    <FastLookWarningsAsErrors>false</FastLookWarningsAsErrors>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.22621.0</WindowsTargetPlatformMinVersion>
    <!-- Unpackaged, self-contained Windows App SDK -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <CppWinRTGenerateWindowsMetadata>true</CppWinRTGenerateWindowsMetadata>
    <MinimalCoreWin>true</MinimalCoreWin>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Build Tools lack the VS-provided WindowsXaml\...\Microsoft.Windows.UI.Xaml.Cpp.targets; use our stand-in. -->
    <_CppCommonExtensionTargets>$(MSBuildProjectDirectory)\WinUI.Cpp.targets</_CppCommonExtensionTargets>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>$(FastLookToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(RepoRoot)build\FastLook.Cpp.props" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <LinkIncremental Condition="'$(Configuration)'=='Debug'">true</LinkIncremental>
    <LinkIncremental Condition="'$(Configuration)'=='Release'">false</LinkIncremental>
    <TargetName>FastLook.Viewer</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <AdditionalIncludeDirectories>$(RepoRoot)third_party\lexilla\include;$(ProjectDir);$(GeneratedFilesDir);$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateWindowsMetadata>false</GenerateWindowsMetadata>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="*.xaml" Exclude="App.xaml" />
    <Midl Include="*.idl" />
    <Midl Update="*.idl" DependentUpon="%(Filename).xaml" SubType="Code" />
    <ClInclude Include="**\*.h" Exclude="obj\**" />
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="**\*.cpp" Exclude="pch.cpp;obj\**" />
    <ClInclude Update="*.xaml.h" DependentUpon="%(Filename)" />
    <ClCompile Update="*.xaml.cpp" DependentUpon="%(Filename)" />
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
    <PRIResource Include="Strings\**\*.resw" />
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="Viewer.rc" />
  </ItemGroup>
  <!-- Microsoft.UI.Xaml.winmd mentions CoreWebView2 (the WebView2 control). C++/WinRT needs its metadata to project WinUI;
       FastLook never uses WebView2, so the winmd is compile-only (Private=false) and nothing is deployed. -->
  <!-- Version coupling: Microsoft.WindowsAppSDK.WinUI depends on Microsoft.Web.WebView2. FastLookWebView2Version pins that
       version in one place (PackageReference and winmd path both use it). If WinUI moves to a newer WebView2, restore fails
       with NU1605 until this value is raised. -->
  <PropertyGroup>
    <FastLookWebView2Version>1.0.3719.77</FastLookWebView2Version>
    <!-- Never copy WebView2Loader.dll next to the exes (no WebView2 in any FastLook process). -->
    <WebView2NeverCopyLoaderDllToOutputDirectory>true</WebView2NeverCopyLoaderDllToOutputDirectory>
    <WebView2LoaderPreference>None</WebView2LoaderPreference>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="$(FastLookWebView2Version)" PrivateAssets="all" />
    <Reference Include="$(NuGetPackageRoot)microsoft.web.webview2\$(FastLookWebView2Version)\lib\Microsoft.Web.WebView2.Core.winmd">
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\FastLook.Core.vcxproj" />
    <ProjectReference Include="..\Lexilla\FastLook.Lexilla.vcxproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="3.0.260818.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
